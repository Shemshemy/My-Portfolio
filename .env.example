# ==============================================================================
# Dennis Shem Limo Portfolio CMS - Environment Variables
# ==============================================================================

# Application Port (Set automatically by Render / Railway / Heroku / Cloud Run)
PORT=5000

# Secret Key for Flask session and cookies
SECRET_KEY=change-this-to-a-strong-random-secret-key

# Admin Key for access to /admin portal and CMS APIs
PORTFOLIO_ADMIN_KEY=dennis2024

# Path to SQLite database file (Use a persistent mount path on cloud providers if available)
DATABASE_PATH=portfolio.db

# Path to uploaded media files
UPLOAD_FOLDER=assets/images/uploads

# Gunicorn concurrency settings (Optional)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
LOG_LEVEL=info
